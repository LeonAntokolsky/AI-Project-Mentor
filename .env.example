# Google AI Studio API Key (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Bot Configuration (from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Your personal Telegram user/chat ID (can be obtained via @userinfobot)
TELEGRAM_CHAT_ID=your_personal_chat_id

# Absolute path to the target pet-project on the host machine
TARGET_PROJECT_PATH=/path/to/my/pet-project

# Reminder interval in hours (e.g., 24 or 12)
PING_INTERVAL_HOURS=24
